{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dougalhanson.com/streetparking/schema/rule.schema.json",
  "title": "Rules pack",
  "type": "object",
  "required": ["id", "name", "timezone", "instrument", "rules"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "timezone": { "type": "string" },
    "instrument": {
      "type": "object",
      "required": ["title", "url"],
      "properties": {
        "title": { "type": "string" },
        "citation": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "altUrl": { "type": "string", "format": "uri" }
      }
    },
    "rules": { "type": "array", "items": { "$ref": "#/$defs/rule" } }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "required": ["id", "number", "title", "plain", "sources", "verification"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "number": { "type": "string", "description": "Rule number in the instrument, e.g. '168' or '318(3)'." },
        "title": { "type": "string" },
        "plain": { "type": "string", "description": "Plain-English effect, as used in advice text." },
        "quote": { "type": ["string", "null"], "description": "Verbatim extract, only when copied from the instrument." },
        "params": { "type": "object", "description": "Machine-usable numbers (metres, minutes)." },
        "appliesTo": { "type": "array", "items": { "type": "string" }, "description": "Panel kinds this rule governs, or 'general'." },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["url", "kind"],
            "properties": {
              "url": { "type": "string", "format": "uri" },
              "kind": { "type": "string", "enum": ["legislation", "government", "council", "secondary"] },
              "note": { "type": "string" }
            }
          }
        },
        "verification": {
          "type": "object",
          "required": ["status", "checkedOn"],
          "properties": {
            "status": {
              "type": "string",
              "enum": ["verified_primary", "verified_secondary", "needs_primary_check", "disputed"],
              "description": "verified_primary = wording checked against legislation text; verified_secondary = consistent across >=2 official gov/council sources; needs_primary_check = drafted from memory/secondary, must be checked."
            },
            "checkedOn": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
            "checkedBy": { "type": "string" },
            "notes": { "type": "string" }
          }
        }
      }
    }
  }
}
